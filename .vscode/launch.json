{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run full pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "1b. Run full pipeline (fast test)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": ["--fast"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Preprocessing only",
      "type": "debugpy",
      "request": "launch",
      "module": "src.preprocessing",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Modelling only",
      "type": "debugpy",
      "request": "launch",
      "module": "src.modeling",
      "args": ["--fast"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. Load into MySQL",
      "type": "debugpy",
      "request": "launch",
      "module": "src.sql_loader",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
